// #disable, interpreted and translated: the rule numbers must agree, or the
// wrong rules go off. Every kind that takes a number is here -- a rule, a
// module's rule and one in its #in block -- and some of each are switched
// off. A #local formula and an instance binding take NO number: they say what
// a local is, and cannot be disabled. A rule that runs leaves a mark; a
// disabled one leaves its variable at 0.
// cycles: 20
#timer T 30 = 1
#variable A = 0
#variable B = 0
#variable C = 0
#variable D = 0
#local L = A + 10                 // -
A = 1                             // 1
B = 2 ? A == 1                    // 2  off
#module M
  #local X in = 0
  #variable V = 0
  #variable W = 0
  #local Y = X * 2                // -
  V = Y ? X > 0                   // 3
  #in INIT
    W = 7                         // 4  off
  #end
#end
#M m1 X <- A                      // -
#M m2 X <- L                      // -
C = L                             // 5  off
D = 4 ? timeout(T)                // 6
T = 1 ? timeout(T)                // 7
#disable 2 4-5
