// #buffer used directly as a heap-backed scalar (like a variable). A buffer's
// size is in BYTES, so scalar access is always byte-aligned: the VIEW_HEAP
// "simple" memcpy fast path. Writes wider than the buffer are masked to its byte
// width (only that many bytes are stored). Sub-byte masking is no longer a
// buffer's job -- use #variable for a masked scalar and #field for a bit-view;
// the sub-byte bitpack path is exercised by pack/can_pack (3- and 2-bit fields).

#buffer B1:1
#buffer B2:2
#buffer B3:3
#buffer Masked1:1
#buffer Masked2:2

B1 = 200     ? 1     // fits in 1 byte
B2 = 5000    ? 1     // fits in 2 bytes
B3 = 1000000 ? 1     // fits in 3 bytes
Masked1 = 300   ? 1  // 300   & 0xff   = 44
Masked2 = 70000 ? 1  // 70000 & 0xffff = 4464
