%% Age counts Tk.period per tick and a timer fires at most once per cycle, so
%% the counters advance in step with the cycle number. seq only -- `n = n + 1`
%% is unguarded and so has no reactive trigger (see can_pack.expect).
{modes, [seq]}.
%% The values here are driven by timeout(), so the clock has to be the thing
%% that advances -- not the host's sleep policy. --virtual-time jumps to the next
%% timer deadline each cycle: deterministic, instant, and unaffected by whether
%% the program happens to settle. (It did not use to need saying: the loop slept
%% unconditionally, which made one cycle equal one timer period by accident.)
{virtual_time, true}.
{cycles, 26}.
{lib, ["lib/watchdog.csp"]}.
{checks, [
  {object_var, 8, "Watchdog.wt", "wt.Lost", 0},
  {object_var, 8, "Watchdog.wt", "wt.Age", 0},
  {final_object_var, "Watchdog.wt", "wt.Lost", 1},
  {final_object_var, "Watchdog.wt", "wt.Age", 30}
]}.
