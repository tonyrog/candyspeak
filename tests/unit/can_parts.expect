%% Frame parts read off the buffer, so a field answers for its frame too:
%% V.id == F300.id. True is -1 in CandySpeak (BOOL(y) = -(y!=0)), same as
%% changed()/rising().
%% .rx must stay 0: no driver is attached in the test suite, so no frame can
%% ever arrive.
%% seq only for the same reason as can_pack: plain `=` rules have no reactive
%% trigger, which is by design.
{modes, [seq]}.
{checks, [
  {final_var, "fid", 768},
  {final_var, "vid", 768},
  {final_var, "gotrx", 0},
  {final_var, "didtx", -1},
  {final_var, "d0", 8},
  {final_var, "d1", 3},
  {final_var, "d2", 8},
  {final_var, "dout", 2},
  {final_var, "din", 1},
  {final_var, "dfld", 2}
]}.
%% d1 == 3 also pins down that .dlc is read back IMMEDIATELY within a cycle: it
%% lives on the buffer, not in a DIN/DOUT-shadowed value slot. Contrast .period
%% on a timer, which is shadowed and would still read the old value here.
