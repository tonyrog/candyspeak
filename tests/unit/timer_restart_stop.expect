%% T is restarted at ticks 2, 4 .. 10 and runs out once, 35 ms after the last
%% restart (tick 11 -> 14). Restarting a running timer used to be a no-op, and
%% it ran out every 35 ms from the first start. T2 is stopped one tick after it
%% was started and never runs out.
{virtual_time, true}.
{cycles, 40}.
{checks, [
  {var, 10, "F", 0},
  {final_var, "F", 1},
  {final_var, "NF", 14},
  {final_var, "G", 0}
]}.
