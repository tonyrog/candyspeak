# A good stroke: right 200 ms after left.
0     Left=0 Right=0
1000  Left=1
1200  Right=1
# Left lets go: the stroke stops at once.
1500  Left=0
# Left again without releasing right: no re-initiation.
1800  Left=1
# Both released, then left alone for too long -- 0.5 s and more.
2500  Left=0 Right=0
3000  Left=1
3700  Right=1
