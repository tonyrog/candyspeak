// Frame packing:  <buffer> <<= <field>...   (blank-separated bit fields)
//   <field> := <expr> [':' <bits>]
// Fields fill ascending bit offsets, each masked to its width.

#buffer Frame:8
#variable A:3 = 5
#variable B:2 = 3
#variable C:3 = 6
#variable Packed = 0

#buffer F2:8
#variable X = 1
#variable Expr = 0

Frame <<= A B C ? 1            // default widths -> 5 | 3<<3 | 6<<5 = 221
F2 <<= (X+4):3 X:2 6:3 ? 1     // expression + literal -> 5 | 1<<3 | 6<<5 = 205

Packed = Frame ? 1
Expr = F2 ? 1
