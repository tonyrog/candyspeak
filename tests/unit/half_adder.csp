// 1-bit values are unsigned: a set bit reads back 1, not -1 (a 1-bit *signed*
// integer holds only 0 or -1). Signedness is the variable's declared type.
#module HalfAdd
#variable A:1 unsigned in = 0
#variable B:1 unsigned in = 0
#variable S:1 unsigned out = 0
#variable C:1 unsigned out = 0

S = A ^ B ? 1
C = A & B ? 1
#end

#HalfAdd h1

h1.A = 1 ? 1
h1.B = 1 ? 1
