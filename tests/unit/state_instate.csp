// OP_INSTATE block gate: each #in <state> block must run only in its state and
// the machine must progress s1 -> s2 -> s3. A wrong INSTATE skip distance would
// run the wrong block or skip rules, giving different X/State. Deterministic:
// reaches a fixed point at State=s3, X=30.
#states s1 s2 s3
#variable X integer = 0

#in INIT
  State = s1
#end

#in s1
  X = 10, State = s2 ? X == 0
#end

#in s2
  X = 20, State = s3 ? X == 10
#end

#in s3
  X = 30 ? X == 20
#end
