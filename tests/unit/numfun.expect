%% Values are Q16.16 in the default build, so the floats are checked through
%% the state dump's decimal rendering. seq only -- unguarded `=` rules have no
%% reactive trigger (see can_pack.expect for the rationale).
{modes, [seq]}.
{cycles, 10}.
{checks, [
  {final_var, "ci",  -1.0},
  {final_var, "mn",  -2.5},
  {final_var, "mx",  1.25},
  {final_var, "ab",  2.5},
  {final_var, "mix", 1.25},
  {final_var, "ii",  3},
  {final_var, "ai",  5},
  {final_var, "tr",  -2},
  {final_var, "rn",  -3},
  {final_var, "ni",  -2},
  {final_var, "pi",  1}
]}.
