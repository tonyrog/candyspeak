# <ms> sms "<from>" "<text>": a message arrives
100   sms "+46701234567" "T"
200   sms "+46709999999" "T"
300   sms "0046731234567" "> Limit = 9"
400   sms "+46701234567" "/clear"
500   sms "+46701234567" "> T = 3"
600   sms "+46701234567" "T = 3 ? 1"
700   Alarm=1
800   sms "+46701234567" "> println(Limit * 2)"
900   sms "+46701234567" "> Go = 1"
