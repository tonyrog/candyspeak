// Frame parts. These read off the buffer, not out of a value slot, so they
// work through the frame AND through any field of it.
//   .id  the CAN frame id
//   .rx  a frame arrived and is readable this cycle (false: no bus here)
//   .tx  a send has been requested
// No bus is involved: with no driver attached nothing is ever received, so .rx
// must stay 0, and .tx must reflect what a rule asked for.
#buffer F300:8 out can 0x300
#field V:8 unsigned F300[0..7]

#variable fid = 0
#variable vid = 0
#variable gotrx = 1
#variable didtx = 0

fid = F300.id      // 0x300 = 768
vid = V.id         // a field answers for its frame
gotrx = F300.rx    // starts at 1, must be driven to 0
F300.tx = 1
didtx = F300.tx

// .dlc starts at the declared frame size and is clamped to it on write: the
// heap holds nbytes and no more, so a longer frame would read past the buffer.
#variable d0 = 0
#variable d1 = 0
#variable d2 = 0
// .dir is a property of the BUFFER, so it answers for a plain #buffer, for a
// CAN frame, and for a field of one. DIR_IN=1, DIR_OUT=2.
#buffer F301:8 in can 0x301
#variable dout = 0
#variable din  = 0
#variable dfld = 0
dout = F300.dir    // 2, out
din  = F301.dir    // 1, in
dfld = V.dir       // 2, the field reads its frame

d0 = F300.dlc      // 8, the declared size
F300.dlc = 3
d1 = F300.dlc      // 3
F300.dlc = 99
d2 = F300.dlc      // 8, clamped
