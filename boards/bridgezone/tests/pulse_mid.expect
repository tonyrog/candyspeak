{modes, [seq]}.
{stimulus, "boards/bridgezone/tests/pulse_mid.dat"}.
%% Stopped in the SECOND pulse's hold: activated at ~100 ms, the first pulse
%% ends at ~700, the second ramps up 700..800 and holds from 800 to 1000.
{cycles, 90}.
{checks, [
  {final_object_var, "Output.o2", "o2.State", 7},
  {final_object_var, "Output.o2", "o2.Duty", 65535},
  {final_object_var, "Output.o2", "o2.Repeat", 1},
  {final_var, "Pout2", 1023}
]}.
