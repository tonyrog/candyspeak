%% Arduino Uno R4 Minima -- Renesas RA4M1.
{board, minima,
 [{toolchain, arduino_cli},
  {fqbn, "arduino:renesas_uno:minima"},
  {port, "/dev/ttyACM0"},
  {nm, "arm-none-eabi-nm"},
  {optimize, "-Os"},
  %% This core inlines hard enough to undo the size work; each of these is a
  %% separate way gcc was found to do it.
  {cflags, "-fno-inline-functions-called-once -fno-inline -fno-ipa-cp-clone "
	   "-fno-ipa-sra -fno-partial-inlining -fno-ipa-icf"},
  {define, ['CSP_ARENA_MALLOC']},

  %% PINNED, so a build is reproducible: without this arduino-cli uses
  %% whatever core happens to be installed, and a core update changes the
  %% firmware with nothing in the tree to show for it. Feeds sketch.yaml.
  {platform, "arduino:renesas_uno", "1.6.0"},

  {support_reactive, 0},
  {use_statistics, 0}]}.
