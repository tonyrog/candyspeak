{modes, [seq]}.
{stimulus, "boards/wintersbone/tests/sms_command.dat"}.
{cycles, 120}.
{checks, [
  {output_has, "sms> +46701111111: 200"},
  {output_has, "sms> +46702222222: 1"},
  {final_var, "Rel2", 0},
  {output_has, "sms> +46701111111: denied"},
  {final_var, "Rel1", 1},
  {output_lacks, "sms> +46709999999"},
  {final_var, "Rel3", 1},
  %% Status is an `in` variable: an SMS may set it, and the report its rules
  %% print is an event -- to every number, not only the one who asked.
  {output_has, "sms> +46701111111: in 200 out 0"},
  {output_has, "sms> +46702222222: in 200 out 0"}
]}.
