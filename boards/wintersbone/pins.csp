// wintersbone -- the hardware, and nothing else.
//
// Arduino MKR NB 1500. Kept apart from main.csp so a test can import the logic
// with the same names and drive them from a stimulus file.
//
// The I2C buffers go through Wire (CSP_HAS_I2C in wintersbone.terms). On the
// host they are what the stimulus writes.

// Four relays, D1..D4, on an opto-isolated module. Most such modules are
// ACTIVE LOW -- see main.csp, which writes !R1On.
#digital Rel1 out 1
#digital Rel2 out 2
#digital Rel3 out 3
#digital Rel4 out 4

// The LiPo, through the board's own divider: 4.3 V full scale. ADC_BATTERY is
// pin 32 in the MKR variants -- check against variant.h before trusting it.
#analog Batt:10 unsigned in 32

// Water pressure, a 0.5-4.5 V transducer on 5 V, divided by 2/3 into A1.
#analog Press:10 unsigned in 16

// The BQ24195 charger: system status register 0x08. Bit 2 is PG_STAT, power
// good -- USB (that is, the mains adapter) is present.
#buffer Pmic:1 in i2c 0 0x6B 0x08
#field  PwrGood:1 Pmic[2]

// ITS WATCHDOG, OFF. The BQ24195 goes back to its power-on settings if no one
// writes to it for 40 s -- 100 mA input limit, 4.36 V input floor -- which
// undoes what the board's own initVariant set (2 A, 3.88 V), and under load
// from the modem it then stops calling the input "power good": POWER OFF by
// SMS with the mains plugged in. Arduino's BQ24195 library turns the watchdog
// off first thing; initVariant does not. Register 5, 0x9A -> 0x8A: watchdog
// bits 5:4 to 00, charge termination and safety timer left as they were.
#buffer PmicCtl:1 out i2c 0 0x6B 0x05

// Two DS18B20 on one 1-Wire line, D5, with a pull-up to 3.3 V (4.7k; two 10k
// in parallel do). Powered -- three wires -- not parasite.
//
// Which is which is each sensor's ROM id, and that belongs to the NODE, not to
// this file: set it once on the board and keep it with /save --
//
//   > /onewire 0:5                         lists the ids on the wire
//   > TinRom = "28ff641f0716a3c2"          the one inside
//   > ToutRom = "28aa12045e1603f1"         the one outside
//   > /save
//
// -- by SMS as well. Until set, a sensor is not read and its value stays 0.
// The scratchpad's first two bytes are the temperature: signed,
// little-endian, 1/16 degree a step. One conversion serves both.
#param  TinRom  string = ""
#param  ToutRom string = ""
#buffer Tin:2  in onewire 0:5 TinRom
#buffer Tout:2 in onewire 0:5 ToutRom
#field  TinRaw:16  Tin[0..15]
#field  ToutRaw:16 Tout[0..15]
