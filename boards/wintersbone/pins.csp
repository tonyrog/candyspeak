// wintersbone -- the hardware, and nothing else.
//
// Arduino MKR NB 1500. Kept apart from main.csp so a test can import the logic
// with the same names and drive them from a stimulus file.
//
// The I2C buffers go through Wire (CSP_HAS_I2C in wintersbone.terms). On the
// host they are what the stimulus writes.

// Four relays, D1..D4, on an opto-isolated module. Most such modules are
// ACTIVE LOW -- see main.csp, which writes !R1On.
#digital Rel1 out 1
#digital Rel2 out 2
#digital Rel3 out 3
#digital Rel4 out 4

// The LiPo, through the board's own divider: 4.3 V full scale. ADC_BATTERY is
// pin 32 in the MKR variants -- check against variant.h before trusting it.
#analog Batt:10 unsigned in 32

// Water pressure, a 0.5-4.5 V transducer on 5 V, divided by 2/3 into A1.
#analog Press:10 unsigned in 16

// The BQ24195 charger: system status register 0x08. Bit 2 is PG_STAT, power
// good -- USB (that is, the mains adapter) is present.
#buffer Pmic:1 in i2c 0 0x6B 0x08
#field  PwrGood:1 Pmic[2]

// Two DS18B20 on one 1-Wire line, D5, with a 4.7k pull-up to 3.3 V. Powered
// (three wires), not parasite. Each is picked out by its ROM id -- these are
// PLACEHOLDERS: run `/onewire 0:5` on the board and paste the two lines it
// prints over them, inside first if you can tell them apart by warming one.
//
// The scratchpad's first two bytes are the temperature: signed, little-endian,
// 1/16 degree a step. One conversion serves both (port/csp_arduino.c).
#buffer Tin:2  in onewire 0:5 0x28000000 0x00000001
#buffer Tout:2 in onewire 0:5 0x28000000 0x00000002
#field  TinRaw:16  Tin[0..15]
#field  ToutRaw:16 Tout[0..15]
