%% Arduino Micro -- ATmega32U4. 2560 bytes of RAM but only 28672 usable flash:
%% the Caterina USB bootloader takes 4K where the Uno's optiboot takes 512, and
%% the software USB CDC stack costs another ~2.9K on top. Exec-only does not
%% fit yet.
{board, micro,
 [{toolchain, arduino_cli},
  {chip, atmega32u4},
  {fqbn, "arduino:avr:micro"},
  {port, "/dev/ttyACM0"},
  {nm, "avr-nm"},
  {optimize, "-Os"},
  {cflags, "-fno-inline-functions-called-once -mcall-prologues"},
  {ldflags, "-Wl,--relax"},
  {define, ['CSP_ARENA_MALLOC', {'CSP_ROM_RECOVER', 0}]},

  %% PINNED, so a build is reproducible: without this arduino-cli uses
  %% whatever core happens to be installed, and a core update changes the
  %% firmware with nothing in the tree to show for it. Feeds sketch.yaml.
  {platform, "arduino:avr", "1.8.8"},

  {support_reactive, 0},
  {use_statistics, 0}]}.
