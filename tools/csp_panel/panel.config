%% -*- erlang -*-
[
 {csp_panel,
  [
   {mode, pause},             %% run | pause
   {trace, hide},             %% hide | show
   {code, ladder},            %% hide | ladder | code
   {theme, light},            %% dark | light
   %% the code view's highlights, any css colour
   %% the chat (needs ellm and rester on the path, see the Makefile):
   %% {chat, [{dir, "demo"},              %% where it saves programs
   %%         {node_control, false}]},    %% may it set/step a NODE
   %% {chat, off},
   {colors, [{true,   "#3f3"},   %% a contact that holds now
             {fired,  "#fb3"},   %% a coil whose rule fired
             {next,   "#fb3"},   %% outline: the guard holds now
             {block,  "#bdf"},   %% the #in / #when block in force
             {want,   "#4af"},   %% marked: should hold
             {unwant, "#f55"}]}  %% marked: should not
  ]},

 %% ellm's own: backend, model, key. Keep the key itself out of this file --
 %% "$ANTHROPIC_API_KEY" or ".authinfo" (see ellm's README).
 {ellm, [{backend, claude},
          {claude, [{model, "claude-opus-5-5"},
                    {apikey, "$ANTHROPIC_API_KEY"}]}]},

 %% Rest library config
 {rester, [
	   {ssl_options,
	    [{cacertfile, "/etc/ssl/certs/ca-certificates.crt"}]}
	  ]},

 {can, 
  [
   {interfaces,
    [

     {can_udp, 0, 
      [
       {name,   "can_udp-0"},
       {maddr,  {224,0,0,1}},   %% multicast address
       {ifaddr, {0,0,0,0}},     %% interface to use
       {ttl,    0},             %% range of multicast ttl (0=host, 1=localnet)
       {mport,  51712},         %% multicast port
       {fd,true}                %% handle FD frames
      ]},

     {can_usb, 1, 
      [
        {device,"/dev/serial/by-id/usb-LAWICEL_CANUSB_*-if00-port0"},
        {name,   "can_usb-1"},
        {bitrate, 250000},             %% CAN bitrate
        {status_interval,undefined},   %% check controller for error etc
        {baud, 115200},                %% serial uart baudrate
        {retry_interval, 2000},        %% retry open device at this rate
        {fd, false}                    %% CANUSB do not support FD
      ]},

     {can_sock, 2,
      [
       {device, "can0"},             %% first available
       {name, "can_sock-2"},
       {bitrate, 500000},            %% bus speed is 500KHz
       {datarate, 2000000},          %% send data at 2MHz
       {fd, true},                   %% enable FD frames
       {listen_only,false},          %% passive 
       {restart_ms, 100}             %% restart interval for error conditions
      ]},

     {can_sock, 3,
      [
       {device, "vcan0"},            %% first available
       {name, "can_sock-3"}
      ]}
    ]}
  ]}
].

