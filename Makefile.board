# Build a firmware for one board:  make -f Makefile.board BOARD=dl1200
#
# Everything that varies comes from boards/<BOARD>.terms -- the chip, the pin
# mux, the power word, the linker script. Nothing below names a part.
#
# Output lands in build/<BOARD>/, Arduino-style: one directory per board, so
# switching boards does not mean a clean.

BOARD ?= dl1200
GEN   := escript utils/gen_chips.erl

# WHERE THE OUTPUT GOES: next to the board's own terms file, not into one shared
# build/ tree.
#
#   private/dl1200/dl1200.terms  ->  private/dl1200/build/dl1200/
#   boards/bridgezone.terms      ->  boards/build/bridgezone/
#
# A pile of firmware images that all look alike is how one ends up flashing the
# wrong board. A path that names the board is a better guard than remembering
# which build was which -- and a private board's output stays in its own repo,
# which is where it belongs.
#
# BUILD_DIR= overrides the whole thing.
BUILD_DIR ?= $(shell $(GEN) --dir-of $(BOARD))/build

# WHAT KIND OF BOARD THIS IS. A bare-metal board names a {chip, ...} and gets a
# pin mux, a power word and a linker script generated here; an Arduino board
# names an {fqbn, ...} and hands the core, the mux and the link to arduino-cli.
# One terms file per board either way -- which is the point, because a board
# used to be described in boards/<name>.h AND CandySpeak/Makefile.<name>, and
# nothing made the two agree.
TOOLCHAIN := $(shell $(GEN) --toolchain-of $(BOARD))

ifeq ($(TOOLCHAIN),arduino_cli)

# WHICH ARCHITECTURE, on a board that has more than one. An RP2350 carries two
# Cortex-M33 AND two Hazard3 RISC-V cores, and which pair runs is chosen at boot
# out of OTP -- so to a build it is a different toolchain end to end, not a
# flag. Empty for every board that has one architecture, which is all of them
# but that one.
#
#   make -f Makefile.board BOARD=rp2350_can ARCH_VARIANT=riscv
#   make -f Makefile.board BOARD=rp2350_can variants
ARCH_VARIANT ?=
AVAR := $(shell $(GEN) --variant-of $(BOARD) $(ARCH_VARIANT))

FQBN := $(shell $(GEN) --fqbn-of $(BOARD))
DEV  := $(shell $(GEN) --port-of $(BOARD))
# The variant's own binutils when it has one: an arm-none-eabi-nm on a RISC-V
# elf says "File format not recognized", which reads as a broken build.
NM   := $(shell $(GEN) --nm-of $(BOARD) $(AVAR))
OPT  := $(shell $(GEN) --optimize-of $(BOARD))
# Per-board compiler and LINK flags. The link ones have to go through
# compiler.c.elf.extra_flags: -Wl,--relax in the compile flags is silently
# ignored, because arduino-cli links as a separate step.
BCFLAGS  := $(shell $(GEN) --cflags-of $(BOARD))
BLDFLAGS := $(shell $(GEN) --ldflags-of $(BOARD))

# The sketch folder: an .ino and a pile of symlinks back to the sources. No
# variant in the path -- arduino-cli keys its own cache on the build path, and
# the flag stamp below covers the rest.
SKETCH := CandySpeak
# Under the board, beside its terms file -- the same place a bare-metal board
# builds. This was only possible once the sketch stopped symlinking boards/:
# with CandySpeak/boards -> ../boards, a build path here landed INSIDE the
# sketch tree and arduino-cli tried to compile its own output. The sketch now
# links src/ instead, and boards/ is out of its reach.
# The variant is in the PATH and in the PROFILE name, always -- never only in
# one of them. An `rp2350_can` directory that is secretly the ARM build is how
# the wrong image gets flashed; the bare-metal branch names its build
# directories after the region map for exactly this reason.
PROFILE := $(BOARD)$(if $(AVAR),-$(AVAR),)
B       := $(BUILD_DIR)/$(PROFILE)
# arduino-cli's build path is a SUBdirectory, not $(B) itself: --clean wipes
# whatever --build-path points at, and the generated csp_board.h lives in $(B).
# Pointed at the same directory, the clean build deletes the header it is about
# to include -- which reads as "csp_board.h: No such file or directory" from a
# rule that just said it wrote one.
CLIB   := $(B)/cli

# ABSOLUTE. arduino-cli compiles with the sketch folder as the working
# directory, so a relative -I would be resolved against CandySpeak/ and the
# generated header would not be found.
BOARDINC := $(abspath $(B))
# The core's own headers. Absolute, because arduino-cli compiles with the sketch
# folder as the working directory.
COREINC  := -I$(abspath include) -I$(abspath gen) -I$(abspath src)

# THE PROGRAM THE BOARD CARRIES. Read the same way as in the bare-metal branch
# below, and for the same reason: a board's program is a property of the board,
# not of whatever was compiled last.
#
# The sketch reaches it through port/csp_rom.c, which CandySpeak/rom.c symlinks
# to -- arduino-cli compiles only what is in the sketch folder, so the image has
# to be #included rather than handed to the link. That file has the details.
#
# With PROG empty the sketch includes gen/rom_host.c, the neutral image, which
# is what the bare-metal branch links in the same case.
BOARDDIR := $(shell $(GEN) --dir-of $(BOARD))
PROG     ?= $(wildcard $(BOARDDIR)/pins.csp)
ROMDEF   := $(if $(strip $(PROG)),,-DCSP_ROM=rom_host.c)
ROMSRC   := $(if $(strip $(PROG)),$(B)/csp_rom.c,)

# csp_config.h does `#include CSP_STR(CSP_BOARD)`, so the value is a path, not a
# quoted string -- the stringify happens there. See its comment.
CSPFLAGS := $(OPT) -I$(BOARDINC) $(COREINC) -DCSP_BOARD=csp_board.h $(ROMDEF) $(BCFLAGS) $(EXTRA)

OPTS = --build-property "compiler.c.extra_flags=$(CSPFLAGS)" \
       --build-property "compiler.cpp.extra_flags=$(CSPFLAGS)" \
       $(if $(BLDFLAGS),--build-property "compiler.c.elf.extra_flags=$(BLDFLAGS)",)

TERMS := $(wildcard boards/*.terms) $(wildcard boards/*/*.terms) \
         $(wildcard private/*/*.terms) $(wildcard chips/*/*.terms) \
         $(wildcard chips/*/*/*.terms)

all: compile

$(B)/csp_board.h: $(TERMS) utils/gen_chips.erl
	@mkdir -p $(B)
	@$(GEN) --board $(BOARD) $@

# The board's program, compiled to an image by ./csp -- the same compiler the
# REPL uses, so what the board carries and what a typed line produces come from
# one place. Into the build directory, never over gen/rom.c: that one is the
# HOST demo image, and overwriting it makes a board's program the baseline every
# test then runs on top of.
#
# $(B), not $(CLIB): --clean wipes the arduino-cli build path, and this file is
# a prerequisite of the build rather than an output of it. Same reason
# csp_board.h lives there.
#
# The .cspprog stamp is what make cannot work out on its own: PROG is a LIST OF
# NAMES, and switching from one program to another leaves the image newer than
# its new source. make then has nothing to rebuild, the board keeps the previous
# program, and the build says nothing about it. Recording the names and
# rewriting the stamp only when they move gives the rule something to depend on
# -- the same trap, and the same answer, as .cspflags below.
$(B)/csp_rom.c: $(PROG) $(B)/.cspprog csp
	@mkdir -p $(B)
	@./csp -n -C -O $@ $(PROG)
	@sed -n 's|^//   size: *|  rom: |p' $@

# Touched only when the list actually changes, so an unrelated build does not
# recompile the image.
$(B)/.cspprog: FORCE
	@mkdir -p $(B)
	@printf '%s\n' '$(PROG)' | cmp -s - $@ 2>/dev/null || printf '%s\n' '$(PROG)' > $@

FORCE:

# ./csp is the compiler above. Built by the top-level Makefile; no prerequisites
# here, so this runs only when the binary is missing.
csp:
	@$(MAKE) --no-print-directory -f Makefile csp

# ONE sketch.yaml with a profile per board -- every board shares the sketch, so
# it cannot be per-board. It pins the core and library VERSIONS, which is the
# half of the build that was previously "whatever is installed on this machine".
# It cannot carry -I/-D; those stay in OPTS below.
#
# `--dump-profile` on a working build is how the library list is found: play
# quietly links Adafruit Circuit Playground and feather_can four libraries, none
# of which is visible in the sources.
$(SKETCH)/sketch.yaml: $(TERMS) utils/gen_chips.erl
	@$(GEN) --sketch-yaml $@

# arduino-cli decides what to rebuild from SOURCE contents -- it does NOT key
# its cache on the --build-property flags it was invoked with. So flipping a -D
# silently relinks objects compiled with the OLD flags, and the board runs
# something matching neither what you wrote nor what you asked for. That is the
# "I changed it and nothing happened" trap, and it costs an evening every time.
#
# Stamp the flags next to the objects and force one clean build when they move.
# An ordinary source edit still builds incrementally. The stamp is written
# AFTER the build, never before: --clean wipes the build path.
FLAGS_KEY = $(CSPFLAGS)

# -m $(BOARD), not --fqbn: the profile carries the fqbn AND the pinned versions.
compile: $(B)/csp_board.h $(ROMSRC) $(SKETCH)/sketch.yaml
	@if [ "$$(cat $(B)/.cspflags 2>/dev/null)" = '$(FLAGS_KEY)' ]; then \
	    arduino-cli compile -e -m $(PROFILE) $(OPTS) --build-path $(abspath $(CLIB)) $(SKETCH); \
	else \
	    echo "build flags changed -> clean build"; \
	    arduino-cli compile -e --clean -m $(PROFILE) $(OPTS) --build-path $(abspath $(CLIB)) $(SKETCH); \
	fi
	@printf '%s\n' '$(FLAGS_KEY)' > $(B)/.cspflags

exec:
	@$(MAKE) --no-print-directory -f Makefile.board BOARD=$(BOARD) compile \
	    EXTRA="-DCSP_EXEC_ONLY $(EXTRA)"

min:
	@$(MAKE) --no-print-directory -f Makefile.board BOARD=$(BOARD) compile \
	    EXTRA="-DCSP_EXEC_ONLY -DCSP_NO_EEPROM $(EXTRA)"

upload: compile
	arduino-cli upload -p $(DEV) -m $(PROFILE) --input-dir $(abspath $(CLIB)) $(SKETCH)

# Text size per symbol, largest first -- the list to read when it does not fit.
#
# The binutils may not be on PATH: arduino-cli installs a toolchain per core
# under ~/.arduino15 and never puts it there. avr-nm and arm-none-eabi-nm
# usually come from the distribution as well, but riscv32-unknown-elf-nm and
# xtensa-esp32s3-elf-nm do not -- so look the tool up rather than assume it,
# and say which one is missing instead of printing a table of zeroes.
NMBIN = $$(command -v $(NM) 2>/dev/null || \
	   find $$HOME/.arduino15/packages -name $(NM) -type f 2>/dev/null | head -1)

size:
	@nm=$(NMBIN); \
	 test -n "$$nm" || { echo "$(NM): not on PATH and not under ~/.arduino15"; exit 1; }; \
	 $$nm --size-sort -S -C $(CLIB)/*.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; printf "%6d  %s\n", n, $$4}' | \
	  sort -rn | head -25
	@nm=$(NMBIN); \
	 $$nm --size-sort -S -C $(CLIB)/*.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; \
	    if ($$4 ~ /^(csp_|setup_|eval[0-9]|est_|fn_|add_|op_info|tok_table|decl_table|build_dis_ip|can_mark_fields|main$$|loop$$)/) ours+=n; \
	    else core+=n } \
	    END {printf "\n%6d  CandySpeak\n%6d  core/libs\n%6d  TOTAL text\n", ours, core, t}'

# Stack-watch build. -finstrument-functions puts a call pair on every function
# entry and exit, so the deepest point is MEASURED instead of guessed at -- see
# __cyg_profile_func_enter in src/csp_rt.c. A diagnostic build, never a shipped
# one: /memory then reports the margin AND the function that was deepest.
watch:
	@$(MAKE) --no-print-directory -f Makefile.board BOARD=$(BOARD) compile \
	    EXTRA="-DCSP_STACK_WATCH -finstrument-functions $(EXTRA)"

# Resolve the `at 0xADDR` from that margin row to a function.
#
# BOTH scales are printed because an AVR function pointer is a WORD address:
# the byte address is twice the value, and which one you have depends on where
# the number came from. Guessing wrong lands you in a plausible neighbour.
whichfn:
	@test -n "$(ADDR)" || { \
	    echo "usage: make -f Makefile.board BOARD=$(BOARD) whichfn ADDR=0x17e1"; \
	    exit 1; }
	@elf=$$(echo $(CLIB)/*.ino.elf); \
	 for scale in 1 2; do \
	   b=$$(( $(ADDR) * scale )); \
	   printf "ADDR*%d = 0x%X:\n" $$scale $$b; \
	   $(NM) -C $$elf | grep -iE ' [tTwW] ' | sort | \
	     awk -v t=$$b '{a=strtonum("0x"$$1)} a<=t {last=$$0} \
			   a>t {print "  "last" <-- here"; print "  "$$0; exit}'; \
	 done

clean:
	rm -rf $(B)

maps:
	@echo "$(BOARD): arduino-cli board, no region maps"

# What `maps` is on the bare-metal side: the builds this board can produce that
# are not interchangeable.
variants:
	@v=$$($(GEN) --variants $(BOARD)); \
	 test -n "$$v" || { echo "$(BOARD): one architecture, no variants"; exit 0; }; \
	 first=1; \
	 for x in $$v; do \
	     if [ $$first = 1 ]; then echo "  $$x   (default)"; first=0; \
	     else echo "  $$x"; fi; \
	 done

.PHONY: all compile exec min upload size clean maps variants watch whichfn FORCE

else

# One directory per VARIANT, and the variant is the region map -- because that
# is what actually makes two builds of the same board incompatible. A `plain`
# image and a `usb_boot` image are linked for different addresses and look
# identical on disk; keeping them apart by name is cheaper than telling them
# apart afterwards.
# ARM=1 builds the whole firmware in ARM mode instead of Thumb. It goes in its
# own directory for the same reason the map does: two images that look identical
# on disk and behave differently are how the wrong one gets flashed.
#
# Costs about 38% of text on this port. What it buys is that ARM/Thumb
# interworking stops existing -- no linker veneers, no bx-through-a-pointer in
# the interrupt dispatch, no -marm exception for vic_212x.c.
# DIAG=1 is in the name for the same reason: it changes CFLAGS but no header, so
# -MMD would not rebuild anything and a diagnostic build would quietly be the
# previous image.
VARIANT := $(shell $(GEN) --map-of $(BOARD) $(MAP))$(if $(ARM),-arm,)$(if $(DIAG),-diag,)
B       := $(BUILD_DIR)/$(VARIANT)

# One fact per query. Parsing the human listing through `head` closed the pipe
# and left escript dying on EPIPE -- noisy, and it would have masked a real
# error the day one appeared.
#
# The chip NAME is not asked for: nothing below uses it, and each of these is a
# separate escript start -- about a second before any compiling begins.
ARCH  := $(shell $(GEN) --arch-of $(BOARD))

# Which region map to build against. A board may carry several -- `make -f
# Makefile.board BOARD=dl1200 MAP=usb_boot` -- and with none given the board's
# {active_map,...} decides. `make -f Makefile.board BOARD=x maps` lists them.
MAP   ?=

# -marm everywhere when ARM=1. vic_212x.c's own rule adds -marm again, which is
# harmless.
THUMB := $(if $(ARM),-marm,-mthumb)

# The family's own {arch, ...}. It used to be a two-valued guess derived from
# the entry symbol; the terms have said this all along.
# The NXP-only pieces: the boot LED/bit-bang diagnostics and the I2C EEPROM
# backend. Named here so both LPC branches can say it in one word.
NXPCOMMON := chips/nxp/drivers/common/csp_board.c \
             chips/nxp/drivers/common/csp_eeprom_i2c.c

# The STM32F4 branch. No vendor HAL: cmsis-device-f4 is the register map and
# chips/arm/cmsis is ARM's core layer, and everything between those and
# CandySpeak is port/csp_stm32.c. See chips/arm/README.md for why the CMSIS
# core has a home of its own -- ST does not ship one, NXP ships eight.
ifeq ($(ARCH),cortex_m4)
  # softfp, not hard: the FPU is enabled (SystemInit sets CPACR) but nothing in
  # CandySpeak is floating point -- its arithmetic is Q16.16 -- so there is no
  # reason to change the ABI of every call for it.
  CPU     := -mcpu=cortex-m4 -mthumb -mfloat-abi=softfp -mfpu=fpv4-sp-d16
  CHIPINC := -Icmsis-device-f4/Include -Ichips/arm/cmsis
  CHIPDEF := -DCHIP_STM32F4 -DCSP_HAVE_FLASH
  STARTUP := chips/st/drivers/f405/startup_f405.c
  SYSINIT := chips/st/drivers/f405/sysinit_f405.c
  PORTSRC := port/csp_stm32.c
  DRV     := chips/st/drivers/f405/flash_f405.c \
             chips/st/drivers/f405/i2c_f405.c \
             chips/st/drivers/f405/spi_f405.c
  # ST's boot loader is selected by the BOOT pins and checks nothing, so there
  # is no checksum word to patch into the image -- unlike every LPC here, where
  # a wrong one silently enters ISP instead of running.
  NOCHECKSUM := 1
else ifeq ($(ARCH),cortex_m3)
  CPU     := -mcpu=cortex-m3 -mthumb
  LPC     := chips/nxp/lpcopen/lpc175x_6x/lpc_chip_175x_6x
  CHIPINC := -I$(LPC)/inc
  CHIPDEF := -DCORE_M3
  STARTUP := chips/nxp/drivers/175x/startup_cm3.c
  SYSINIT := chips/nxp/drivers/175x/sysinit_175x.c
  PORTSRC := port/csp_lpcopen.c $(NXPCOMMON)
  DRV     := $(addprefix $(LPC)/src/, chip_17xx_40xx.c clock_17xx_40xx.c \
               sysctl_17xx_40xx.c sysinit_17xx_40xx.c iocon_17xx_40xx.c \
               gpio_17xx_40xx.c uart_17xx_40xx.c adc_17xx_40xx.c \
               timer_17xx_40xx.c can_17xx_40xx.c)
else
  CPU     := -mcpu=arm7tdmi $(THUMB)
  CHIPINC := -Ichips/nxp/drivers/212x
  # The family has to NAME itself. csp_lpcopen.c picks its ADC width, UART
  # status style and EEPROM kind from these, and its final #else is written for
  # the 11xx -- so a family with no define of its own is silently configured as
  # one, which cost four dead analog inputs.
  # The only family with a flash backend so far (flash_212x.c), so it is the
  # only one where /upgrade exists. See csp_repl.c.
  CHIPDEF := -DCHIP_LPC212X -DCSP_HAVE_FLASH
  STARTUP := chips/nxp/drivers/212x/startup_212x.S
  SYSINIT := chips/nxp/drivers/212x/sysinit_212x.c
  PORTSRC := port/csp_lpcopen.c $(NXPCOMMON)
  DRV     := chips/nxp/drivers/212x/chip_212x.c \
             chips/nxp/drivers/212x/can_212x.c \
             chips/nxp/drivers/212x/pwm_212x.c \
             chips/nxp/drivers/212x/i2c_212x.c \
             chips/nxp/drivers/212x/flash_212x.c
  # vic_212x.c is ARM, not Thumb: mrs/msr do not exist in Thumb on an ARM7.
  # Its own rule below passes -marm; the file has an #error if that is missed.
  VICSRC  := chips/nxp/drivers/212x/vic_212x.c
endif

CC   := arm-none-eabi-gcc
OC   := arm-none-eabi-objcopy
SZ   := arm-none-eabi-size

# The part that is the same on every target. The PORT layer -- the file that
# knows what a GPIO write is -- is picked by architecture above, because that is
# the whole difference between an LPC build and an STM32 one.
CORE := src/csp_rt.c src/csp_crc.c src/csp_line.c src/csp_compile.c src/csp_repl.c \
        src/csp_parse.c src/csp_tok.c src/csp_print.c gen/csp_strings.c \
        src/csp_eeprom.c src/csp_flash.c src/csp_transport.c

# THE PROGRAM THE BOARD CARRIES IN FLASH.
#
# On a part whose map has an application slot, this no longer means "code linked
# into the interpreter": the generated image is placed on the first byte of that
# slot by the linker script (see ld_image in gen_chips.erl). The runtime becomes
# program-independent -- one firmware for every node -- and the program can be
# replaced by /upgrade without rebuilding it.
#
# Defaults to the board's own pins.csp when there is one. Without this the
# firmware links rom_host.c -- the NEUTRAL image, a couple of declarations and
# no instructions -- and the board comes up with an empty /list and every pin
# name undeclared. Which reads as "the ROM failed to load" and is really "there
# was no ROM": the same symptom, a different place to look.
#
# Several .csp files are read as ONE program, in order, exactly as ./csp reads
# them -- so a board's pin names and an application are two files, not one.
#
#   make -f Makefile.board BOARD=bridgezone
#   make -f Makefile.board BOARD=bridgezone PROG="boards/bridgezone/pins.csp app.csp"
#   make -f Makefile.board BOARD=bridgezone PROG=          # the neutral image
BOARDDIR := $(shell $(GEN) --dir-of $(BOARD))
PROG     ?= $(wildcard $(BOARDDIR)/pins.csp)

ifeq ($(strip $(PROG)),)
  CORE   += gen/rom_host.c
else
  ROMOBJ := $(B)/rom.o
endif

SRC  := $(CORE) $(PORTSRC) $(DRV) $(SYSINIT) $(STARTUP)
OBJ  := $(addprefix $(B)/,$(notdir $(SRC:.c=.o)))
OBJ  := $(OBJ:.S=.o)
ifdef VICSRC
OBJ  += $(B)/vic_212x.o
endif
OBJ  += $(ROMOBJ) $(B)/csp_chip.o

VPATH := . $(dir $(SRC))

# -MMD -MP: header dependencies, generated as a side effect of compiling.
# Without them an edited header leaves every object stale, and the link fails
# against a definition the compiler has already seen -- which reads as a missing
# symbol and sends you looking in entirely the wrong place.
CFLAGS := $(CPU) -Os -ffunction-sections -fdata-sections -Wall -MMD -MP \
          -Iinclude -Igen -Isrc -I$(B) $(CHIPINC) $(CHIPDEF) \
          -DCSP_BOARD=csp_board.h -DCSP_VERSION='"$(BOARD)"' \
          $(if $(DIAG),-DCSP_BITBANG_DIAG)

all: $(B)/firmware.bin $(B)/firmware.hex

# The map is in the build PATH now, so two maps cannot share a linker script.
# When they could, `make MAP=usb_boot` found an up-to-date script from the
# previous map and linked against it: the build succeeded and produced an image
# for the wrong addresses, which is the failure this file exists to prevent.

# The board header and the linker script, both generated. --board refuses for a
# board that does not pass check-boards, so a bad description stops here rather
# than becoming a firmware that comes up almost working.
# Every place a terms file can live. Missing one does not fail loudly -- it
# leaves a STALE generated header, and the build then quietly uses yesterday's
# pin mux. `boards/*/*.terms` was missing after boards got per-board
# directories, and a new {boot_led,...} silently did not appear.
TERMS := $(wildcard boards/*.terms) $(wildcard boards/*/*.terms) \
         $(wildcard private/*/*.terms) $(wildcard chips/*/*.terms) \
         $(wildcard chips/*/*/*.terms)

$(B)/csp_board.h: $(TERMS) utils/gen_chips.erl
	@mkdir -p $(B)
	@$(GEN) --board $(BOARD) $@

# The part's flash geometry and region map, as a table the firmware carries --
# the same terms the linker script above comes from, so the two cannot drift.
$(B)/csp_chip.c: $(TERMS) utils/gen_chips.erl
	@mkdir -p $(B)
	@$(GEN) --device $(BOARD) $(MAP) $@

$(B)/csp_chip.o: $(B)/csp_chip.c
	@$(CC) $(CFLAGS) -c -o $@ $<

$(B)/$(BOARD).ld: $(TERMS) utils/gen_chips.erl
	@mkdir -p $(B)
	@$(GEN) --ld $(BOARD) $(MAP) > $@

# The board's program, compiled to a ROM image by ./csp -- the same compiler the
# REPL uses, so what flash carries and what a typed line produces come from one
# place. Lands in the build directory rather than over rom.c in the tree: rom.c
# is the host demo image and swapping the two is how a program becomes the
# baseline every test then runs on top of.
# .cspprog for the same reason as in the arduino branch: PROG is a list of
# NAMES, and switching from one program to another usually leaves the image
# newer than its new source, so make finds nothing to do and the firmware keeps
# the program before it -- silently. `make prog_check` is the test.
$(B)/rom.c: $(PROG) $(B)/.cspprog csp $(B)/csp_board.h
	@mkdir -p $(B)
	@./csp -n -C -O $@ $(PROG)
	@sed -n 's|^//   size: *|  rom: |p' $@

$(B)/.cspprog: FORCE
	@mkdir -p $(B)
	@printf '%s\n' '$(PROG)' | cmp -s - $@ 2>/dev/null || printf '%s\n' '$(PROG)' > $@

FORCE:

$(B)/rom.o: $(B)/rom.c
	@$(CC) $(CFLAGS) -c -o $@ $<

# ./csp is the compiler above. Built by the top-level Makefile; no prerequisites
# here, so this runs only when the binary is missing.
csp:
	@$(MAKE) --no-print-directory -f Makefile csp

$(B)/%.o: %.c $(B)/csp_board.h
	@mkdir -p $(B)
	@$(CC) $(CFLAGS) -c -o $@ $<

$(B)/%.o: %.S $(B)/csp_board.h
	@mkdir -p $(B)
	@$(CC) $(CPU) -Iinclude -Igen -Isrc -I$(B) -c -o $@ $<

$(B)/vic_212x.o: $(VICSRC) $(B)/csp_board.h
	@$(CC) $(CFLAGS) -marm -c -o $@ $<

LD := $(B)/$(BOARD).ld

$(B)/firmware.elf: $(OBJ) $(LD)
	@$(CC) $(CPU) -nostartfiles -Wl,--gc-sections -Wl,-T,$(LD) \
	   -o $@ $(OBJ) -lc -lgcc
	@$(SZ) $@

# The checksum goes in LAST, on the finished binary. The word at 0x14 must make
# the eight vectors sum to zero or the boot ROM enters ISP instead of running
# the program -- silently, with no output and nothing a debugger can see.
# --gap-fill 0xFF, not the default 0. With the program's image in an application
# slot there is a GAP between the end of the runtime and that slot, and a flat
# file has to say something about it. 0 says "write zeros there", which is wrong
# twice: it is not what an erased part reads, and flash only goes 1 -> 0 without
# an erase. 0xFF says "erased", which is the truth.
$(B)/firmware.bin: $(B)/firmware.elf csp
	@$(OC) -O binary --gap-fill 0xFF $< $@
	@$(if $(NOCHECKSUM),echo "$@: no checksum word on this family",./csp --checksum=$@)

# A .hex as well, and prefer it when flashing. A raw .bin is just bytes: byte 0
# is the LOWEST section address, and nothing in the file says what that address
# was -- so an image linked for 0x8000 and flashed from 0 lands 32K out, with
# the vector table looking right and everything it points at wrong. Intel hex
# carries the address of every record, so the tool cannot get it wrong.
#
# Made from the patched .bin, not from the .elf, so it carries the checksum.
#
# The address is CHECKED before it is used. Every call to the generator is a
# $(shell ...), so a generator that fails for any reason -- and one did, on a
# node-name clash under a parallel make -- hands back an empty string, and
# `--change-addresses=` with nothing after it writes a hex file for address 0.
# That flashes without complaint and runs nowhere. An empty answer must stop the
# build, not become a default.
$(B)/firmware.hex: $(B)/firmware.bin
	@addr=$$($(GEN) --load-addr $(BOARD) $(MAP)); \
	 case "$$addr" in \
	   ''|*[!0-9x]*) echo "$@: load address came back as '$$addr' -- refusing to build a hex file with no address" >&2; exit 1;; \
	 esac; \
	 $(OC) -I binary -O ihex --change-addresses=$$addr $< $@ && \
	 echo "$@: load address $$addr"

-include $(OBJ:.o=.d)

maps:
	@$(GEN) --maps $(BOARD)

clean:
	@rm -rf $(B)

.PHONY: all clean maps FORCE

endif
