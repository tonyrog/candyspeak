# Simply use arduino-cli
#
FQBN=arduino:samd:mkrzero
DEV=/dev/ttyACM0
# CSP_ARENA_MALLOC: claim the pool from the heap at boot, sized to freeRam() minus
# the stack reserve, rather than a fixed CSP_CODE_BUDGET. Model with: ./csp --board mkrzero
ARENA=-DCSP_ARENA_MALLOC
OPTS=--build-property "compiler.c.extra_flags=-Os $(ARENA)" \
     --build-property "compiler.cpp.extra_flags=-Os $(ARENA)"

compile:
	arduino-cli compile -e --fqbn $(FQBN) $(OPTS)

# Stack-watch diagnostic build (see Makefile.mega for the full explanation):
# adds the /memory `margin` row and, with -finstrument-functions, the deepest
# function. SAMD has 32K RAM so the stack/arena collision is far less likely
# here than on a mega, but the tooling is the same.
BPATH="./build/arduino.samd.mkrzero"
WATCH_FLAGS=$(ARENA) -DCSP_STACK_WATCH -finstrument-functions

watch:
	arduino-cli compile -e --fqbn $(FQBN) \
	  --build-property "compiler.c.extra_flags=-Os $(WATCH_FLAGS)" \
	  --build-property "compiler.cpp.extra_flags=-Os $(WATCH_FLAGS)"

# Resolve a `margin ... at 0xADDR`. ARM function pointers carry the Thumb bit
# (LSB=1), so mask it before looking up the symbol.
#   usage: make -f Makefile.mkrzero whichfn ADDR=0x1234
whichfn:
	@test -n "$(ADDR)" || { echo "usage: make -f Makefile.mkrzero whichfn ADDR=0x1234"; exit 1; }
	@b=$$(( ($(ADDR)) & ~1 )); \
	 printf "0x%X (Thumb bit cleared):\n" $$b; \
	 arm-none-eabi-nm -C $(BPATH)/CandySpeak.ino.elf | grep -iE ' [tTwW] ' | sort | \
	   awk -v t=$$b '{a=strtonum("0x"$$1)} a<=t {last=$$0} a>t {print "  "last" <-- here"; print "  "$$0; exit}'

clean:
	arduino-cli compile --clean --fqbn $(FQBN) .

upload:
	arduino-cli upload -p $(DEV) --fqbn $(FQBN)
