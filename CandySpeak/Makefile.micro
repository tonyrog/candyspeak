# Simply use arduino-cli
#
FQBN=arduino:avr:micro
DEV=/dev/ttyACM0
BPATH="./build/tmp.arduino.avr.micro"
# CSP_ARENA_MALLOC: claim the pool from the heap at boot, sized to freeRam() minus
# the stack reserve -- so the arena is however much RAM is actually free after the
# core and every linked library took theirs, decided at runtime rather than by a
# per-board CSP_CODE_BUDGET constant. Model it on the host with: ./csp --board mega
BOARD=-DCSP_BOARD=boards/micro.h
# -fno-inline-functions-called-once: gcc folds every single-call function into
# its caller, which buried csp_eval_rule and csp_rt_start inside main and made
# the size listing useless (main showed 5 966 bytes of "something"). Turning it
# off costs NOTHING here -- it is 148 bytes SMALLER, because the folding only
# duplicated code -- and the per-function sizes become the truth.
#
# The other -fno-* flags that used to sit here are GONE. Measured on this build:
# -fno-inline, -fno-ipa-cp-clone, -fno-ipa-sra, -fno-partial-inlining and
# -fno-ipa-icf together cost 1 598 bytes. They look like they should help -- IPA
# constant-propagation turns every st->field into a 4-byte absolute lds where an
# indexed ldd is 2 -- but the specialisation pays for itself several times over,
# and -fno-ipa-icf switches off exactly the identical-function folding this code
# leans on.
INLINE=-fno-inline-functions-called-once $(PROLOGUES)

# -mcall-prologues is the single biggest flag on this target: 33 524 -> 31 202
# with the old flag set, and 29 604 with both this and the cleanup above.
#
# WHY it is worth so much here. AVR's ABI makes r18-r27 and r30-r31 call-
# clobbered but r2-r17 and r28-r29 call-saved, so any value a function keeps
# alive ACROSS a call has to move into a call-saved register and be pushed in
# the prologue and popped in the epilogue. A 32-bit value is four registers, so
# a function holding four of them over a call pays 32 bytes of push and 32 of
# pop -- and our big ones do exactly that (16-18 push/pop each, measured).
#
# This flag emits a call to __prologue_saves__/__epilogue_restores__ in libgcc
# instead: ONE shared copy for the whole image, two calls per function instead
# of up to 64 bytes. It costs cycles on every call that saves registers, which
# is why it is a variable -- a timing-critical build can say PROLOGUES=.
PROLOGUES=-mcall-prologues

# Linker relaxation: rewrite call/jmp (4 bytes) as rcall/rjmp (2) wherever the
# target is within +/-2K. Worth 348 bytes here. It has to go on the LINK step --
# -mrelax in compiler.c.extra_flags does nothing, because arduino-cli links in a
# separate invocation, and that is why this is its own build-property rather
# than another entry in INLINE.
RELAX=--build-property "compiler.c.elf.extra_flags=-Wl,--relax"

OPTS=--build-property "compiler.c.extra_flags=-Os $(BOARD) $(INLINE) $(EXTRA)" \
     --build-property "compiler.cpp.extra_flags=-Os $(BOARD) $(INLINE) $(EXTRA)" \
     $(RELAX)

compile:
	arduino-cli compile -e --fqbn $(FQBN) $(OPTS) --build-path $(BPATH)

# --- exec-only ---------------------------------------------------------------
# The Micro has 28 672 usable bytes (32K minus the bootloader), so the full
# build does not fit and never will. These two drop what a node that only RUNS
# a flashed ROM has no use for:
#
#   CSP_EXEC_ONLY  no scanner, no parser, no REPL commands. A ROM image is
#                  compiled on the host and an EEPROM patch is stored already
#                  compiled, so nothing on the board parses text.
#   CSP_NO_EEPROM  no patch layer at all. On a 1 kB part it costs more flash
#                  than the patching is worth.
#
# `size` prints where it lands without flashing anything.
exec:
	$(MAKE) -f Makefile.micro compile EXTRA="-DCSP_EXEC_ONLY"

# Text size per symbol, largest first -- the list to read when it does not fit.
size:
	@avr-nm --size-sort -S -C $(BPATH)/CandySpeak.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; printf "%6d  %s\n", n, $$4}' | \
	  sort -rn | head -100
	@avr-nm --size-sort -S -C $(BPATH)/CandySpeak.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; \
	    if ($$4 ~ /^(csp_|setup_|eval[0-9]|est_|fn_|add_|op_info|tok_table|decl_table|build_dis_ip|can_mark_fields|main$$)/) ours+=n; \
	    else core+=n } \
	    END {printf "\n%6d  CandySpeak (main = setup+loop, inlined)\n%6d  core/libc/USB\n%6d  TOTAL text\n", ours, core, t}'

# --- stack watch -----------------------------------------------------------
# Diagnose the stack/arena collision (blank decls, reboot loops). Two layers,
# both behind #ifdef CSP_STACK_WATCH so a normal build carries none of it:
#
#   CSP_STACK_WATCH          adds the "at 0x..." column to /memory's margin row:
#                            the function that got closest to the arena.
#   -finstrument-functions   makes gcc sample stack depth on EVERY function
#                            entry, so that "closest" is found by measurement,
#                            not by hand-placed probes. Costs ~4.5K flash.
#
# Read the margin row: `margin  -NNN  at 0xADDR`. Negative = the stack has been
# inside the declarations. Resolve ADDR with:  make -f Makefile.micro whichfn ADDR=0xADDR
#
# The margin row itself (without the fn address) is ALWAYS present -- csp_stack_mark
# samples the known-deep points (csp_eval_rule, csp_parse, csp_parse_expr, pmatch)
# in every build. This target adds the address and full coverage.
WATCH_FLAGS=$(BOARD) -DCSP_STACK_WATCH -finstrument-functions

watch:
	arduino-cli compile -e --fqbn $(FQBN) \
	  --build-property "compiler.c.extra_flags=-Os $(WATCH_FLAGS)" \
	  --build-property "compiler.cpp.extra_flags=-Os $(WATCH_FLAGS)" \
	  --build-path $(BPATH)

# Resolve a `margin ... at 0xADDR` value to a function. AVR function pointers on
# a 256K part are WORD addresses, so the real byte address is ADDR*2 -- this
# prints the symbol at both interpretations so you can't pick the wrong one.
#   usage: make -f Makefile.micro whichfn ADDR=0x17e1
whichfn:
	@test -n "$(ADDR)" || { echo "usage: make -f Makefile.micro whichfn ADDR=0x17e1"; exit 1; }
	@elf=$(BPATH)/CandySpeak.ino.elf; \
	 for scale in 1 2; do \
	   b=$$(( $(ADDR) * scale )); \
	   printf "ADDR*%d = 0x%X:\n" $$scale $$b; \
	   avr-nm -C $$elf | grep -iE ' [tTwW] ' | sort | \
	     awk -v t=$$b '{a=strtonum("0x"$$1)} a<=t {last=$$0} a>t {print "  "last" <-- here"; print "  "$$0; exit}'; \
	 done

clean:
	arduino-cli compile --clean --fqbn $(FQBN) .

upload:
	arduino-cli upload -p $(DEV) --fqbn $(FQBN)

strings:
	avr-objcopy -O binary --only-section=.data build/arduino.avr.micro/CandySpeak.ino.elf mega_data.bin
	strings -n 4 mega_data.bin
