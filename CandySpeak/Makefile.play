# Simply use arduino-cli
#
FQBN=arduino:samd:adafruit_circuitplayground_m0
DEV=/dev/ttyACM0
BPATH="./build/arduino.samd.adafruit_circuitplayground_m0"
BOARD=-DCSP_BOARD=boards/play.h
OPTS=--build-property "compiler.c.extra_flags=-Os $(BOARD) $(EXTRA)" \
     --build-property "compiler.cpp.extra_flags=-Os $(BOARD) $(EXTRA)"

# arduino-cli decides what to rebuild from SOURCE contents -- it does not key the
# cache on the --build-property flags it was invoked with. So flipping a -D
# (EXTRA=, or editing which one BOARD points at) silently relinks objects that
# were compiled with the OLD flags, and the board runs something that matches
# neither what you wrote nor what you asked for. That is the "I changed it and
# nothing happened" trap, and it costs an evening every time.
#
# Stamp the flags next to the objects and force one clean build when they move.
# A rebuild after an ordinary source edit is still incremental.
FLAGS_KEY=$(BOARD) $(EXTRA)

# The stamp is written AFTER the build, never before: --clean wipes the build
# path, so a stamp laid down first goes with it.
compile:
	@if [ "$$(cat $(BPATH)/.cspflags 2>/dev/null)" = '$(FLAGS_KEY)' ]; then \
	    arduino-cli compile -e --fqbn $(FQBN) $(OPTS) --build-path $(BPATH); \
	else \
	    echo "build flags changed -> clean build"; \
	    arduino-cli compile -e --clean --fqbn $(FQBN) $(OPTS) --build-path $(BPATH); \
	fi
	@mkdir -p $(BPATH) && printf '%s\n' '$(FLAGS_KEY)' > $(BPATH)/.cspflags

clean:
	arduino-cli compile --clean --fqbn $(FQBN) .

upload:
	arduino-cli compile --clean --upload -p $(DEV)  --fqbn $(FQBN) $(OPTS) --build-path $(BPATH)

#
# UF2 experminent
#
# uf2conv.py -c -b 0x0000 -f 0x68ED2B88 -o play.uf2 $(BPATH)/CandySpeak.ino.bin
#

# --- exec-only ---------------------------------------------------------------
# No scanner, no parser, no REPL: runs the linked ROM image plus any EEPROM
# patch. `size` lists what is actually left, largest first.
exec:
	$(MAKE) -f Makefile.play compile EXTRA="-DCSP_EXEC_ONLY"

size:
	@arm-none-eabi-nm --size-sort -S -C $(BPATH)/CandySpeak.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; printf "%6d  %s\n", n, $$4}' | \
	  sort -rn | head -30
	@arm-none-eabi-nm --size-sort -S -C $(BPATH)/CandySpeak.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; \
	    if ($$4 ~ /^(csp_|setup_|eval[0-9]|est_|fn_|add_|op_info|tok_table|build_dis_ip|can_mark_fields|main$$|loop$$)/) ours+=n; \
	    else core+=n } \
	    END {printf "\n%6d  CandySpeak\n%6d  core/libs\n%6d  TOTAL text\n", ours, core, t}'
