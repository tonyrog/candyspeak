# Adafruit Feather RP2040 CAN Bus -- MCP2515 on SPI0 + TJA1051 transceiver.
#
# Needs Earle Philhower's rp2040 core (Arduino's own mbed_rp2040 core has only
# the Pico) and Adafruit's MCP2515 library:
#   arduino-cli core install rp2040:rp2040 --additional-urls \
#     https://github.com/earlephilhower/arduino-pico/releases/download/global/package_rp2040_index.json
#   arduino-cli lib install "Adafruit MCP2515"
#
FQBN=rp2040:rp2040:adafruit_feather_can
DEV=/dev/ttyS0
BPATH="./build/rp2040.rp2040.adafruit_feather_can"

# CSP_CAN_MCP2515 picks the SPI-attached controller instead of arduino-CAN's
# global. The chip select and the transceiver's standby line come from the board
# variant (PIN_CAN_CS 19, PIN_CAN_STANDBY 16), so they are not repeated here --
# nothing to keep in sync when the variant is the authority.
#
# 500 kbit is the CANopen/DS-401 default. The MCP2515 crystal on this board is
# 16 MHz, which is what the library assumes, so no CSP_CAN_CLOCK is needed.
CAN=-DCSP_HAS_CAN -DCSP_CAN_MCP2515 -DCSP_CAN_BITRATE=500E3
OPTS=--build-property "compiler.c.extra_flags=-Os $(CAN)" \
     --build-property "compiler.cpp.extra_flags=-Os $(CAN)"

compile:
	arduino-cli compile -e --fqbn $(FQBN) $(OPTS) --build-path $(BPATH)

clean:
	arduino-cli compile --clean --fqbn $(FQBN) .

upload:
	arduino-cli upload -p $(DEV) --fqbn $(FQBN) --build-path $(BPATH)

# Watch the bus with a second board, or talk to it from the host over a USB-CAN
# adapter. The .csp side needs nothing board-specific:
#     #buffer F201:8 in  can 0x201
#     #buffer Out:8  out can 0x200
size:
	arduino-cli compile -e --fqbn $(FQBN) $(OPTS) --build-path $(BPATH) 2>&1 | tail -3
