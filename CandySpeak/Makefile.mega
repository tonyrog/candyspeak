# Simply use arduino-cli
#
FQBN=arduino:avr:mega
#DEV=/dev/serial/by-id/usb-Arduino_Srl_Arduino_mega_55431313038351C04281-if00
DEV=/dev/ttyACM0
BPATH="./build/tmp.arduino.avr.mega"
# CSP_ARENA_MALLOC: claim the pool from the heap at boot, sized to freeRam() minus
# the stack reserve -- so the arena is however much RAM is actually free after the
# core and every linked library took theirs, decided at runtime rather than by a
# per-board CSP_CODE_BUDGET constant. Model it on the host with: ./csp --board mega
BOARD=-DCSP_BOARD=boards/mega.h
INLINE=-fno-inline-functions-called-once $(PROLOGUES)
# See Makefile.micro for why this is worth kilobytes on AVR: prologue and
# epilogue register saving becomes two calls into libgcc instead of up to 64
# bytes of push/pop per function. Set PROLOGUES= to trade the flash back for
# cycles.
PROLOGUES=-mcall-prologues

# Linker relaxation -- see Makefile.micro. Must be a LINK flag; -mrelax in
# extra_flags is silently ignored because arduino-cli links separately.
RELAX=--build-property "compiler.c.elf.extra_flags=-Wl,--relax"

OPTS=--build-property "compiler.c.extra_flags=-Os $(BOARD) $(INLINE) $(EXTRA)" \
     --build-property "compiler.cpp.extra_flags=-Os $(BOARD) $(INLINE) $(EXTRA)" \
     $(RELAX)

compile:
	arduino-cli compile -e --fqbn $(FQBN) $(OPTS) --build-path $(BPATH)


exec:
	$(MAKE) -f Makefile.micro compile EXTRA="-DCSP_EXEC_ONLY"

min:
	$(MAKE) -f Makefile.micro compile EXTRA="-DCSP_EXEC_ONLY -DCSP_NO_EEPROM"

# Text size per symbol, largest first -- the list to read when it does not fit.
size:
	@avr-nm --size-sort -S -C $(BPATH)/CandySpeak.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; printf "%6d  %s\n", n, $$4}' | \
	  sort -rn | head -25
	@avr-nm --size-sort -S -C $(BPATH)/CandySpeak.ino.elf | \
	  awk '$$3=="T"||$$3=="t"{n=strtonum("0x"$$2); t+=n; \
	    if ($$4 ~ /^(csp_|setup_|eval[0-9]|est_|fn_|add_|op_info|tok_table|decl_table|build_dis_ip|can_mark_fields|main$$)/) ours+=n; \
	    else core+=n } \
	    END {printf "\n%6d  CandySpeak (main = setup+loop, inlined)\n%6d  core/libc/USB\n%6d  TOTAL text\n", ours, core, t}'

# --- stack watch -----------------------------------------------------------
# Diagnose the stack/arena collision (blank decls, reboot loops). Two layers,
# both behind #ifdef CSP_STACK_WATCH so a normal build carries none of it:
#
#   CSP_STACK_WATCH          adds the "at 0x..." column to /memory's margin row:
#                            the function that got closest to the arena.
#   -finstrument-functions   makes gcc sample stack depth on EVERY function
#                            entry, so that "closest" is found by measurement,
#                            not by hand-placed probes. Costs ~4.5K flash.
#
# Read the margin row: `margin  -NNN  at 0xADDR`. Negative = the stack has been
# inside the declarations. Resolve ADDR with:  make -f Makefile.mega whichfn ADDR=0xADDR
#
# The margin row itself (without the fn address) is ALWAYS present -- csp_stack_mark
# samples the known-deep points (csp_eval_rule, csp_parse, csp_parse_expr, pmatch)
# in every build. This target adds the address and full coverage.
WATCH_FLAGS=$(BOARD) -DCSP_STACK_WATCH -finstrument-functions

watch:
	arduino-cli compile -e --fqbn $(FQBN) \
	  --build-property "compiler.c.extra_flags=-Os $(WATCH_FLAGS)" \
	  --build-property "compiler.cpp.extra_flags=-Os $(WATCH_FLAGS)" \
	  --build-path $(BPATH)

# Resolve a `margin ... at 0xADDR` value to a function. AVR function pointers on
# a 256K part are WORD addresses, so the real byte address is ADDR*2 -- this
# prints the symbol at both interpretations so you can't pick the wrong one.
#   usage: make -f Makefile.mega whichfn ADDR=0x17e1
whichfn:
	@test -n "$(ADDR)" || { echo "usage: make -f Makefile.mega whichfn ADDR=0x17e1"; exit 1; }
	@elf=$(BPATH)/CandySpeak.ino.elf; \
	 for scale in 1 2; do \
	   b=$$(( $(ADDR) * scale )); \
	   printf "ADDR*%d = 0x%X:\n" $$scale $$b; \
	   avr-nm -C $$elf | grep -iE ' [tTwW] ' | sort | \
	     awk -v t=$$b '{a=strtonum("0x"$$1)} a<=t {last=$$0} a>t {print "  "last" <-- here"; print "  "$$0; exit}'; \
	 done

clean:
	arduino-cli compile --clean --fqbn $(FQBN) .

upload:
	arduino-cli upload -p $(DEV) --fqbn $(FQBN)

strings:
	avr-objcopy -O binary --only-section=.data build/arduino.avr.mega/CandySpeak.ino.elf mega_data.bin
	strings -n 4 mega_data.bin
