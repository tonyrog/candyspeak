# Simply use arduino-cli
#
FQBN=arduino:avr:mega
DEV=/dev/serial/by-id/usb-Arduino_Srl_Arduino_mega_55431313038351C04281-if00
BPATH="./build/tmp.arduino.avr.mega"
# CSP_ARENA_MALLOC: claim the pool from the heap at boot, sized to freeRam() minus
# the stack reserve -- so the arena is however much RAM is actually free after the
# core and every linked library took theirs, decided at runtime rather than by a
# per-board CSP_CODE_BUDGET constant. Model it on the host with: ./csp --board mega
ARENA=-DCSP_ARENA_MALLOC
OPTS=--build-property "compiler.c.extra_flags=-Os $(ARENA)" \
     --build-property "compiler.cpp.extra_flags=-Os $(ARENA)"

compile:
	arduino-cli compile -e --fqbn $(FQBN) $(OPTS) --build-path $(BPATH)

clean:
	arduino-cli compile --clean --fqbn $(FQBN) .

upload:
	arduino-cli upload -p $(DEV) --fqbn $(FQBN)
