
// Analog.flags
#define ADC_UPPER_LIMIT_EXCEEDED 0x01
#define ADC_BELOW_LOWER_LIMIT 0x02
#define ADC_DELTA 0x04
#define ADC_NEGATIVE_DELTA 0x08
#define ADC_POSITIVE_DELTA 0x10
#define ADC_ALWAYS 0x20 // after each inhibit
#define ADC_ANALOG_TO_DIGITAL 0x80
#define ADC_LIMIT_BITS 0x03
#define ADC_DELTA_BITS 0x1C

#module Analog
  // settings
  // 0x6421  Input Interrupt Trigger Selection  
  #param flags:8 = ADC_DELTA // more than delta
  // 0x6424 Analogue Input Interrupt Upper Limit
  #param upper:32 = 0
  // 0x6425 Analogue Input Interrupt Lower Limit  
  #param lower:32 = 0
  // 0x6426 Analogue Input Interrupt Delta  
  #param delta:32 unsigned = 0 
  // 0x6427 Analogue Input Interrupt Negative Delta
  #param ndelta:32 unsigned = 0
  // 0x6428 Analogue Input Interrupt Positive Delta
  #param pdelta:32 unsigned = 0
  // 0x6431 Analog Input Offset Integer  
  #param offset:32 = 0
  // 0x6432 Analog Input Scaling Integer
  #param scale:32 = 1
  // Sample delay time
  #param delay_tm:32 = 500 // two per second
  // Inhibit time after trigger
  #param inhibit_tm:32 = 1000  // not more then one per second
  // Minimum sample value (clamp)
  #param min_val = 0
  // Maximum sample value (clamp)
  #param max_val = 0x0ffff
  // User input value
  #variable value:16 in
  // Analog output value
  #variable output:16 out
  // Previous trigger mask (cause of interrupt)
  #variable selected:8
  // Last sample value
  #variable last_value:16 unsigned
  // Last sample time
  #variable sample_mark
  // Last output time
  #variable inhibit_mark

  #local sample_mark0 = tick()
  // scale and offset
  #local value1 = value*scale + offset

  // ADC_ANALOG_TO_DIGITAL turns the converter into a THRESHOLD DETECTOR: the
  // value reads 1 above max_val and 0 below min_val, and BETWEEN them nothing
  // is reported at all. That middle is hysteresis, not clamping -- an input
  // sitting on a limit cannot chatter, because leaving the band is what makes
  // news. Reading adc.c's `else { ctx->value = value; return false; }` as
  // "clamp and carry on" is the easy mistake here.
  #local a2d     = (flags & ADC_ANALOG_TO_DIGITAL) != 0
  #local hi      = value1 >= max_val
  #local lo      = value1 <= min_val
  #local clamped = max(min(value1, max_val), min_val)

  // One value per mode, selected with a mask rather than a branch: a comparison
  // yields -1 or 0, so one term is zeroed and the other passes through.
  // -hi turns -1/0 into 1/0.
  #local value2  = (a2d & -hi) | (~a2d & clamped)

  // In A2D mode only the extremes are news. In normal mode every sample is.
  #local edge    = !a2d || hi || lo
  
  #local dv = value2 - last_value

  #local t1 = ((value2 > upper) & ADC_UPPER_LIMIT_EXCEEDED)
  #local t2 = ((value2 < lower) & ADC_BELOW_LOWER_LIMIT)
  #local t3 = ((abs(dv) > delta) & ADC_DELTA)
  #local t4 = ((dv > 0) & (dv > pdelta) & ADC_POSITIVE_DELTA)
  #local t5 = ((dv < 0) & (-dv > ndelta) & ADC_NEGATIVE_DELTA)
  #local mask = t1 | t2 | t3 | t4 | t5
  #local mask1 = mask & flags

  // The two gates adc.c has and this port did not: sampling rate and the
  // inhibit window after a trigger.
  #local due  = (sample_mark0 - sample_mark) >= delay_tm
  #local free = (inhibit_mark == 0) || ((sample_mark0 - inhibit_mark) >= inhibit_tm)
  #local latch = (mask & ADC_ALWAYS) || (mask1 & ADC_DELTA_BITS) || ((mask1 & ADC_UPPER_LIMIT_EXCEEDED) && !(selected & ADC_UPPER_LIMIT_EXCEEDED)) || ((mask1 & ADC_BELOW_LOWER_LIMIT) && !(selected & ADC_BELOW_LOWER_LIMIT))

  sample_mark = sample_mark0 ? due

  // Inside the A2D band: remember the reading, report nothing. This is the one
  // place last_value moves WITHOUT a latch, and it matters -- the next dv is
  // measured from here. adc.c does the same thing, one line before its
  // `return false`.
  last_value = value1 ? due && free && a2d && !hi && !lo

  output = value2 ? latch && edge && due && free
  last_value = value2 ? latch && edge && due && free
  selected   = mask1  ? latch && edge && due && free
  inhibit_mark = sample_mark0 ? latch && edge && due && free
#end
