// Adafruit Circuit Playground Express  (SAMD21 -- ro_ is plain there)
//
// Port convention that csp_arduino interprets:
//   port 0 : GPIO by Arduino pin number  (digital), and A8/A9 analog sensors
//   port 8 : accelerometer  (pin 0/1/2 = X/Y/Z)
//   port 9 : NeoPixel ring   (pin = pixel index 0..9), 16-bit RGB565 "fake DAC"

// --- buttons / switch / onboard LED ---
// CPX buttons A/B are active-high -> need internal pulldown; the slide switch
// is active-low -> needs pullup. (Options go BEFORE the port:pin.)
#digital BtnA   in pulldown 0:4      // button A (pressed = 1)
#digital BtnB   in pulldown 0:5      // button B
#digital Switch in pullup   0:7      // slide switch
#digital Led    out 0:13             // onboard red LED

// --- analog sensors ---
#analog Light:10 in 0:8      // light sensor  (A8)
#analog Temp:10  in 0:9      // thermistor    (A9)
#analog AccX:10  in 8:0      // accelerometer X  (scaled ~-512..511)
#analog AccY:10  in 8:1
#analog AccZ:10  in 8:2

// --- 10 NeoPixels as RGB565 analog outputs (port 9, pin = index) ---
#analog P0:16 out 9:0
#analog P1:16 out 9:1
#analog P2:16 out 9:2
#analog P3:16 out 9:3
#analog P4:16 out 9:4
#analog P5:16 out 9:5
#analog P6:16 out 9:6
#analog P7:16 out 9:7
#analog P8:16 out 9:8
#analog P9:16 out 9:9

// working values
#timer T0 1000 = 1
#timer T1 1100 = 1
#timer T2 1200 = 1
#timer T3 1300 = 1
#timer T4 1400 = 1
#timer T5 1500 = 1
#timer T6 1600 = 1
#timer T7 1700 = 1
#timer T8 1800 = 1
#timer T9 1900 = 1

#variable Idx:8               // tilt-ball ring index 0..9
#variable C0:16 = 0xFD20      // current pixel colour (RGB565)
#variable C1:16 = 0xFD20      // current pixel colour (RGB565)
#variable C2:16 = 0xFD20      // current pixel colour (RGB565)
#variable C3:16 = 0xFD20      // current pixel colour (RGB565)
#variable C4:16 = 0xFD20      // current pixel colour (RGB565)
#variable C5:16 = 0xFD20      // current pixel colour (RGB565)
#variable C6:16 = 0xFD20      // current pixel colour (RGB565)
#variable C7:16 = 0xFD20      // current pixel colour (RGB565)
#variable C8:16 = 0xFD20      // current pixel colour (RGB565)
#variable C9:16 = 0xFD20      // current pixel colour (RGB565)

P0=C0, C0=C0 ^ 0xFFFF, T0=1 ? timeout(T0)
P1=C1, C1=C1 ^ 0xFFFF, T1=1 ? timeout(T1)
P2=C2, C2=C2 ^ 0xFFFF, T2=1 ? timeout(T2)
P3=C3, C3=C3 ^ 0xFFFF, T3=1 ? timeout(T3)
P4=C4, C4=C4 ^ 0xFFFF, T4=1 ? timeout(T4)
P5=C5, C5=C5 ^ 0xFFFF, T5=1 ? timeout(T5)
P6=C6, C6=C6 ^ 0xFFFF, T6=1 ? timeout(T6)
P7=C7, C7=C7 ^ 0xFFFF, T7=1 ? timeout(T7)
P8=C8, C8=C8 ^ 0xFFFF, T8=1 ? timeout(T8)
P9=C9, C9=C9 ^ 0xFFFF, T9=1 ? timeout(T9)
