// This example matches  wokwi.com rp400 traffic light example
// generate a rom ./csp -C -n examples/traffic.csp > rom.c
// make -f Makefile.rp2040
// in wokwi put cursor in edit window and press F1 write "upload" and
// click on Upload firmware. Select CandySpeak.ino.elf / hex
// it will run in about 10-12% of the real speed.
//
#digital Red    out 1
#digital Yellow out 5
#digital Green  out 9
#timer   Phase  1000 = 1
#digital Panic in pulldown 16  // panic button
#states  red redyellow green yellow fail

#module Failsafe
  #digital P1  1
  #digital P5  5
  #digital P9  9
  #timer   T   500
  #variable V = 0

  #in INIT
    P1.dir = out, P1 = 0
    P5.dir = out, P5 = 0
    P9.dir = out, P9 = 0
    V=1
  #end

  P5=V, V=!V ? timeout(T)
  T=1 ? timeout(T)
#end

#Failsafe safe  // this must not be done with real FAILSAFE

#in INIT
    State = red
#end

#in red
    Red=1, Yellow=0, Green=0
    State = redyellow ? timeout(Phase)
#end
#in redyellow
    Red=1, Yellow=1, Green=0
    State = green ? timeout(Phase)
#end
#in green
    Red=0, Yellow=0, Green=1
    State = yellow ? timeout(Phase)
#end
#in yellow
    Red=0, Yellow=1, Green=0
    State = red ? timeout(Phase)
#end
#in red redyellow green yellow
    Phase = 1 ? timeout(Phase)      // restart the timer each phase
    State = fail, safe.State = INIT ? Panic // State = FAILSAFE?
#end
#in fail
    // Do nothing, not needed in real FAILSAFE mode
#end
