// This example matches  wokwi.com rp400 traffic light example
// generate a rom ./csp -C -n examples/traffic.csp > rom.c
// make -f Makefile.rp2040
// in wokwi put cursor in edit window and press F1 write "upload" and
// click on Upload firmware. Select CandySpeak.ino.elf / hex
// it will run in about 10-12% of the real speed.
//
#digital Red    out 1
#digital Yellow out 5
#digital Green  out 9
#digital Please pulldown in 2  // button to allow longer red light
#timer   Phase  2000
#states  green red redyellow yellow
#variable LongRed = 0
#param PhasePeriod = 2000
#param PleasePeriod = 4000

#in INIT
    State = green
    Phase.period = PhasePeriod
    Phase = 1
#end

#in red
    Red=1, Yellow=0, Green=0
    State = redyellow, Phase.period = PhasePeriod ? timeout(Phase)
#end
#in redyellow
    Red=1, Yellow=1, Green=0, LongRed = 0
    State = green ? timeout(Phase)
#end
#in green
    Red=0, Yellow=0, Green=1
    State = yellow ? timeout(Phase)
#end
#in yellow
    Red=0, Yellow=1, Green=0
    State = red ? timeout(Phase)
#end
#in red redyellow green yellow
    LongRed=1, Phase.period=PleasePeriod ? !LongRed && Please
    Phase = 1 ? timeout(Phase)      // restart the timer each phase
#end
