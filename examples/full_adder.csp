#variable F:12 in = 100

#module Add
#variable A:1 in
#variable B:1 in
#variable Cin:1 in
#variable S:1 out
#variable Cout:1 out

S = A ^ B ^ Cin ? 1
Cout = (A & B) | (Cin & (A ^ B)) ? 1
#end

#variable G:16 in = 123

#Add a0
#Add a1
#Add a2

a0.A = 1
a0.B = 1
a0.Cin = 0

a1.A   = 1
a1.B   = 1
a1.Cin = a0.Cout

a2.A = 0
a2.B = 0
a2.Cin = a1.Cout

