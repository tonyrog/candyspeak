// generate and execute all compare instructions
#variable X integer
#variable Y integer = 2
#variable Z integer = 3
#variable F float
#variable G float = 7.0
#variable H float = 5.0
#variable S integer = 0

X = Y < Z,  S=1  ? S==0
X = Y <= Z, S=2  ? S==1
X = Y > Z,  S=3  ? S==2
X = Y >= Z, S=4  ? S==3
X = Y == Z, S=5  ? S==4
X = Y != Z, S=6  ? S==5

F = G  < H, S=7  ? S==6
F = G <= H, S=8  ? S==7
F = G > H,  S=9  ? S==8
F = G >= H, S=10 ? S==9
F = G == H, S=11 ? S==10
F = G != H, S=12 ? S==11
