#module pid
#constant kp float = 0.75
#constant ki float = 0.25
#constant kd float = 0.2
#variable target float in
#constant i_min float = -1.0
#constant i_max float = 1.0
#variable integral float = 0.0
#variable err float
#variable err0 float = 0.0
#variable sp float = 0.0        // set point
#variable tsp in float = 0.0    // taget set point
#variable sp_time float = 0.0
#variable sp_dtsum float = 0.0
#variable temp1 float = 0.0
#variable temp2 float = 0.0
#variable sd float
#variable d1 float
#analog feed:32 float in 7
#analog result:32 float out 8
#constant dt float = 0.01

sp_dtsum = sp_dtsum + dt ? (sp_time < sp_dtsum)
sd = (tsp - sp)/dt
sp = max(sp + sd, target)

err = sp - feed
temp1 = integral + err*dt
temp2 = clip(temp1, i_min, i_max)
d1 = (err - err0) / dt
result = kp*err + ki*temp2 + kd*d1
integral = temp2
err0 = err
#end

