%% LPC2194 -- an LPC2129 with four CAN controllers. Same flash as 212x, so it
%% borrows that group rather than restating it.
{chip, lpc2194, [{group,'212x'}, {id,16#0301FF13}, {flash_kb,256}, {ram_kb,16},
                 {nsect,17}, {peripherals,[{can,4},{uart,2},{i2c,1},{spi,2},
                                           {adc,4},{pwm,6},{rtc,1},{wdt,1}]}]}.
