%% SAMD21 (Cortex-M0+) -- uniform again, but the erase unit is a ROW of four
%% 64-byte pages, so 256 bytes. Writes are per page; erases are per row, and it
%% is the erase unit that a region has to be whole multiples of.
%%
%% No EEPROM on the part. The Arduino cores emulate one in flash, which is why
%% {store, flash} here and a map that reserves the top rows for it -- the same
%% decision an LPC board makes, arrived at from the opposite direction.
{family, samd21,
 [{vendor,      microchip},
  {arch,        cortex_m0plus},
  {store,       flash},
  {flash_base,  16#00000000},
  {ram_base,    16#20000000},
  {ram_reserve, 0}]}.

%% NO sector table. The erase unit is a 256-byte ROW and a 256K part has a
%% thousand of them -- geometry we do not manage, because the Arduino core's
%% FlashStorage owns the emulated EEPROM and nothing here erases a row. Page and
%% row sizes are recorded as information.
{group, 'samd21-256k',
 [{family, samd21},
  {page, 64},                        %% write granularity
  {row, 256}]}.                      %% erase granularity

{chip, samd21g18a,
 [{group, 'samd21-256k'}, {id, 16#10010100},
  {flash_kb, 256}, {ram_kb, 32},
  {peripherals, [{usb,1},{uart,6},{i2c,6},{spi,6},{adc,20},{dac,1},
                 {pwm,3},{rtc,1},{wdt,1}]}]}.

%% --- INTERRUPT SOURCES -------------------------------------------------------
%%
%% The EIC has sixteen EXTINT channels and a FIXED pin-to-channel map: a pin can
%% only ever be the one EXTINT its silicon wires it to, and two pins on the same
%% channel cannot both be sources. Shaped exactly like STM32's EXTI, except the
%% map is arbitrary rather than "the bit number" -- PA02 is EXTINT2 but PB08 is
%% EXTINT8 and PA16 is EXTINT0.
%%
%% NO TABLE HERE, and that is deliberate. Transcribing eighty pin-to-EXTINT rows
%% from a datasheet for a board nothing bare-metal builds would introduce more
%% errors than it caught -- the same call chips/st/README.md makes about the F4
%% pin capability table. The Arduino core already holds the map and answers at
%% run time: digitalPinToInterrupt(pin) returns NOT_AN_INTERRUPT for a pin that
%% cannot, and attachInterrupt on an already-claimed channel silently replaces
%% the earlier one.
%%
%% So a port asks the core. Write the table the day something builds bare-metal
%% for this part, when a pin naming a wrong channel becomes possible.
{irq, samd21,
 [{eic, [{scheme,   runtime},
	 {resolver, "digitalPinToInterrupt"},
	 {channels, 16},
	 {edges,    [rising, falling, both, high, low]}]}]}.
